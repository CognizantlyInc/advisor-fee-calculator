// Cloudflare Workers config.
// Static files are served directly. Requests under /private go through
// src/worker.mjs first, which checks the access code (secret:
// PRIVATE_ACCESS_CODE, set in the Cloudflare dashboard, never in this repo).
{
  "name": "advisor-fee-calculator",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-11-01",
  // Keep the custom domains attached on every deploy.
  "routes": [
    { "pattern": "worththefees.com", "custom_domain": true },
    { "pattern": "www.worththefees.com", "custom_domain": true }
  ],
  "workers_dev": true,
  // Sends private-page enquiries by email (Cloudflare Email Routing).
  // The recipient is the NOTIFY_EMAIL runtime variable, kept out of this repo.
  "send_email": [{ "name": "ENQUIRY_EMAIL" }],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/private", "/private/*"]
  }
}
